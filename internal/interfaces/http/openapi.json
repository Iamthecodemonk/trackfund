  ,
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "fullName",
          "email",
          "phoneNumber",
          "photoUrl",
          "pendingEmail",
          "emailChangeId",
          "emailChangeExpiresAt",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phoneNumber": {
            "type": "string",
            "description": "Normalized international number; empty if unset."
          },
          "photoUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "pendingEmail": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "description": "Not used for sign-in until verified."
          },
          "emailChangeId": {
            "type": "string",
            "nullable": true,
            "description": "Pass as challengeId when verifying the email change."
          },
          "emailChangeExpiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MonoAccount": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "monoAccountId": { "type": "string" },
          "accountName": { "type": "string" },
          "accountNumber": { "type": "string" },
          "bankCode": { "type": "string" },
          "currency": { "type": "string" }
        }
      },
      "MonoTransaction": {
        "type": "object",
        "properties": {
          "transactionId": { "type": "string" },
          "amount": { "type": "integer" },
          "currency": { "type": "string" },
          "paidAt": { "type": "string", "format": "date-time" },
          "description": { "type": "string" }
        }
      },
      "MonoWebhook": {
        "type": "object",
        "properties": {
          "event": { "type": "string" },
          "event_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "data": { "type": "object" }
        }
      }
    }
  }
}
