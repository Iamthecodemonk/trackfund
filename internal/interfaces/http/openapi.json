{
  "openapi": "3.0.0",
  "info": {
    "title": "TrackFund API",
    "version": "0.1.0",
    "description": "Minimal OpenAPI spec for TrackFund"
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": { "type": "string" },
                  "email": { "type": "string" },
                  "phone": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["fullName", "email", "password"]
              },
              "example": {
                "fullName": "Jane Developer",
                "email": "jane@example.com",
                "phone": "",
                "password": "Str0ngP@ssw0rd"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OTP sent",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "OTP sent to jane@example.com",
                  "data": {
                    "email": "jane@example.com",
                    "requiresOtp": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "deviceName": { "type": "string" }
                },
                "required": ["email", "password"]
              },
              "example": {
                "email": "jane@example.com",
                "password": "Str0ngP@ssw0rd",
                "deviceName": "Laptop"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Login successful.",
                  "data": {
                    "user": {
                      "id": "user_1",
                      "fullName": "Jane Developer",
                      "email": "jane@example.com",
                      "role": "USER"
                    },
                    "accessToken": "<jwt>",
                    "refreshToken": "<refresh>"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "summary": "Verify OTP (confirm registration or verify existing user)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "otp": { "type": "string" },
                  "required": ["email", "otp"]
                }
              },
              "example": {
                "email": "jane@example.com",
                "otp": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Email verified successfully. You can now log in."
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/resend-otp": {
      "post": {
        "summary": "Resend OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" }
                }
              },
              "example": {
                "email": "jane@example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "OTP resent to jane@example.com"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "summary": "Forgot password (send OTP)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" }
                }
              },
              "example": {
                "email": "jane@example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "summary": "Reset password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "otp": { "type": "string" },
                  "newPassword": { "type": "string" },
                  "required": ["email", "otp", "newPassword"]
                }
              },
              "example": {
                "email": "jane@example.com",
                "otp": "123456",
                "newPassword": "NewP@ssw0rd"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "summary": "Sign in with Google (provide id_token from client)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": { "type": "string" }
                }
              },
              "example": {
                "idToken": "<google-id-token>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Login successful.",
                  "data": {
                    "user": {
                      "id": "user_1",
                      "fullName": "Google User",
                      "email": "google@example.com",
                      "role": "USER"
                    },
                    "accessToken": "<jwt>",
                    "refreshToken": "<refresh>"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mono/link-session": {
      "post": {
        "summary": "Create a Mono link session (returns client token for frontend/mobile)",
        "security": [{ "bearerAuth": [] }],
        "description": "Returns a short-lived client token that the frontend (web or mobile) uses to open Mono Connect UI. Frontend must authenticate with the app via Bearer token.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "type": "object" },
              "example": { "redirectUrl": "yourapp://mono/callback" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "client token",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "client_token": { "type": "string" }, "expires_in": { "type": "integer" } } },
                "example": { "client_token": "<client-token>", "expires_in": 300 }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/mono/complete-link": {
      "post": {
        "summary": "Exchange Mono short-lived code on server and persist accounts",
        "security": [{ "bearerAuth": [] }],
        "description": "Frontend posts the `code` received from Mono Connect to this endpoint. Server exchanges it with Mono using the secret key and upserts returned accounts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "code": { "type": "string" } }, "required": ["code"] },
              "example": { "code": "mono_code_abc123" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "accounts upserted",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "data": { "type": "object" } } },
                "example": { "ok": true, "data": { "accounts": [ { "id": "internal_id_1", "monoAccountId": "mono_acc_1", "accountName": "Primary" } ] } }
              }
            }
          },
          "400": { "description": "Bad request / invalid code" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/mono/accounts": {
      "get": {
        "summary": "List Mono accounts for the authenticated user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MonoAccount" } },
                "example": [ { "id": "internal_id_1", "monoAccountId": "mono_acc_1", "accountName": "Primary", "accountNumber": "0123456789", "bankCode": "001", "currency": "NGN" } ]
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/mono/accounts/{id}/transactions": {
      "get": {
        "summary": "Get transactions for an internal mono account id",
        "security": [{ "bearerAuth": [] }],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MonoTransaction" } }, "example": [ { "transactionId": "tx_1", "amount": 5000, "currency": "NGN", "paidAt": "2026-06-20T00:00:00Z", "description": "Test payment" } ] } } }, "401": { "description": "Unauthorized" } }
      }
    },
    "/api/mono/webhook": {
      "post": {
        "summary": "Mono webhook endpoint (public)",
        "description": "Mono will POST events here. The server verifies the `mono-webhook-secret` header.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MonoWebhook" },
              "example": { "event": "mono.events.account_connected", "event_id": "evt_123", "timestamp": "2026-06-22T12:00:00Z", "data": { "account": { "id": "mono_acc_abc", "user_id": "user_1", "provider": "mono", "name": "My Account", "account_number": "0123456789", "bank_code": "001", "currency": "NGN" } } }
            }
          }
        },
        "responses": { "200": { "description": "ok" }, "401": { "description": "invalid webhook secret" } }
      }
    },
    "/funds": {
      "post": {
        "summary": "Create fund",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "targetAmount": { "type": "integer" },
                  "currency": { "type": "string" }
                },
                "required": ["name", "targetAmount", "currency"]
              },
              "example": {
                "name": "School Fund",
                "targetAmount": 100000,
                "currency": "USD"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "example": {
                  "fundId": "fund_1"
                }
              }
            }
          }
        }
      }
    },
    "/funds/{id}": {
      "get": {
        "summary": "Get fund",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "example": {
                  "id": "fund_1",
                  "name": "School Fund",
                  "targetAmount": 100000,
                  "currency": "USD",
                  "totalContributions": 25000,
                  "remainingAmount": 75000,
                  "contributionCount": 3
                }
              }
            }
          }
        }
      }
    },
    "/funds/{id}/contributions": {
      "post": {
        "summary": "Record contribution",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": { "type": "integer" },
                  "contributor": { "type": "string" }
                },
                "required": ["amount", "contributor"]
              },
              "example": {
                "amount": 5000,
                "contributor": "Alice"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "accepted",
            "content": {
              "application/json": {
                "example": {
                  "accepted": true
                }
              }
            }
          }
        }
      }
    }
  }
  ,
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "MonoAccount": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "monoAccountId": { "type": "string" },
          "accountName": { "type": "string" },
          "accountNumber": { "type": "string" },
          "bankCode": { "type": "string" },
          "currency": { "type": "string" }
        }
      },
      "MonoTransaction": {
        "type": "object",
        "properties": {
          "transactionId": { "type": "string" },
          "amount": { "type": "integer" },
          "currency": { "type": "string" },
          "paidAt": { "type": "string", "format": "date-time" },
          "description": { "type": "string" }
        }
      },
      "MonoWebhook": {
        "type": "object",
        "properties": {
          "event": { "type": "string" },
          "event_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "data": { "type": "object" }
        }
      }
    }
  }
}