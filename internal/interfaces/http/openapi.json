                  "targetAmount",
                  "currency"
                ]
              },
              "example": {
                "name": "School Fund",
                "targetAmount": 100000,
                "currency": "USD"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
