{
  "openapi": "3.0.0",
  "info": {
    "title": "TrackFund API",
    "version": "0.1.0",
    "description": "Minimal OpenAPI spec for TrackFund"
  },
  "paths": {
    "/api/profile/me": {
      "get": {
        "summary": "Get the signed-in user?s profile",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Returns only the signed-in user. Cache-Control: no-store. No password hashes or verification codes are returned.",
        "responses": {
          "200": {
            "description": "Current authenticated profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Profile"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "user_123",
                    "fullName": "Sample User",
                    "email": "user@example.com",
                    "phoneNumber": "+2348012345678",
                    "photoUrl": null,
                    "pendingEmail": null,
                    "emailChangeId": null,
                    "emailChangeExpiresAt": null,
                    "createdAt": "2026-10-27T09:00:00Z",
                    "updatedAt": "2026-10-27T09:30:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired access token",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Missing, invalid, revoked or expired access token",
                  "code": "unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Profile was not found",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Profile was not found",
                  "code": "profile_not_found"
                }
              }
            }
          },
          "503": {
            "description": "Profile service unavailable",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Profile service unavailable",
                  "code": "profile_unavailable"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update the signed-in user?s profile",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Partial update. Email changes send a verification code to the new address; email remains unchanged and pendingEmail/emailChangeId are returned. Repeat the email PATCH to resend (five requests/hour). Send the current email to cancel a pending change. Fields such as id, userId, role and status are rejected. Null clears phoneNumber/photoUrl. 20 validated updates/minute/user. Photo URL assignment does not upload an avatar.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "fullName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "nullable": true,
                    "description": "International number with country code; common separators are removed."
                  },
                  "photoUrl": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "HTTPS image URL without credentials or fragment, or null."
                  }
                }
              },
              "example": {
                "fullName": "Sample User",
                "phoneNumber": "+2348012345678"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authenticated profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Profile"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "user_123",
                    "fullName": "Sample User",
                    "email": "user@example.com",
                    "phoneNumber": "+2348012345678",
                    "photoUrl": null,
                    "pendingEmail": null,
                    "emailChangeId": null,
                    "emailChangeExpiresAt": null,
                    "createdAt": "2026-10-27T09:00:00Z",
                    "updatedAt": "2026-10-27T09:30:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Malformed JSON",
                  "code": "invalid_json"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Missing or invalid session",
                  "code": "unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Profile was not found",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Profile was not found",
                  "code": "profile_not_found"
                }
              }
            }
          },
          "409": {
            "description": "Email already belongs to another user",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Email already belongs to another user",
                  "code": "email_conflict"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 8 KiB",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Request exceeds 8 KiB",
                  "code": "request_too_large"
                }
              }
            }
          },
          "422": {
            "description": "Field validation failed",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Field validation failed",
                  "code": "validation_failed",
                  "errors": {
                    "email": "Enter a valid email address"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many profile or email requests; see Retry-After",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Too many profile or email requests; see Retry-After",
                  "code": "profile_rate_limited"
                }
              }
            }
          },
          "503": {
            "description": "Storage or email delivery unavailable; other valid profile fields may already have been saved",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Storage or email delivery unavailable; other valid profile fields may already have been saved",
                  "code": "verification_delivery_failed"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile/me/email/verify": {
      "post": {
        "summary": "Verify a pending profile email change",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Code expires after ten minutes and permits five wrong attempts. A successful change revokes existing access and refresh tokens; sign in again with the new email. Twenty verification requests/minute/user. Codes are never returned or logged by the production profile API.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "challengeId",
                  "code"
                ],
                "properties": {
                  "challengeId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}$"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  }
                }
              },
              "example": {
                "challengeId": "0123456789abcdef0123456789abcdef",
                "code": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email changed; fresh login required",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "id": "user_123",
                    "fullName": "Sample User",
                    "email": "new@example.com",
                    "phoneNumber": "+2348012345678",
                    "photoUrl": null,
                    "pendingEmail": null,
                    "emailChangeId": null,
                    "emailChangeExpiresAt": null,
                    "createdAt": "2026-10-27T09:00:00Z",
                    "updatedAt": "2026-10-27T09:30:00Z"
                  },
                  "signInRequired": true
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Malformed JSON",
                  "code": "invalid_json"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Missing or invalid session",
                  "code": "unauthorized"
                }
              }
            }
          },
          "409": {
            "description": "Email became unavailable before verification",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Email became unavailable before verification",
                  "code": "email_conflict"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 8 KiB",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Request exceeds 8 KiB",
                  "code": "request_too_large"
                }
              }
            }
          },
          "422": {
            "description": "Invalid, expired, replaced or non-owned challenge/code",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Invalid, expired, replaced or non-owned challenge/code",
                  "code": "invalid_email_code",
                  "errors": {
                    "email": "Enter a valid email address"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Attempt or request limit exceeded; request a new code or wait",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Attempt or request limit exceeded; request a new code or wait",
                  "code": "email_attempts_exhausted"
                }
              }
            }
          },
          "503": {
            "description": "Profile service unavailable",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Profile service unavailable",
                  "code": "profile_unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/mono/link-session/{reference}": {
      "get": {
        "summary": "Get the authenticated user?s Mono connection session",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connection and transaction-readiness status",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "reference": "saved-reference",
                    "status": "connected",
                    "accountId": "internal-account-id",
                    "dataStatus": "AVAILABLE",
                    "availableData": [
                      "transactions",
                      "balance"
                    ],
                    "transactionsReady": false,
                    "syncStatus": "syncing"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "404": {
            "description": "Session missing or owned by another user"
          },
          "503": {
            "description": "Session storage temporarily unavailable"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": { "type": "string" },
                  "email": { "type": "string" },
                  "phone": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["fullName", "email", "password"]
              },
              "example": {
                "fullName": "Jane Developer",
                "email": "jane@example.com",
                "phone": "",
                "password": "Str0ngP@ssw0rd"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OTP sent",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "OTP sent to jane@example.com",
                  "data": {
                    "email": "jane@example.com",
                    "requiresOtp": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "deviceName": { "type": "string" }
                },
                "required": ["email", "password"]
              },
              "example": {
                "email": "jane@example.com",
                "password": "Str0ngP@ssw0rd",
                "deviceName": "Laptop"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Login successful.",
                  "data": {
                    "user": {
                      "id": "user_1",
                      "fullName": "Jane Developer",
                      "email": "jane@example.com",
                      "role": "USER"
                    },
                    "accessToken": "<jwt>",
                    "refreshToken": "<refresh>"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "summary": "Verify OTP (confirm registration or verify existing user)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "otp": { "type": "string" },
                  "required": ["email", "otp"]
                }
              },
              "example": {
                "email": "jane@example.com",
                "otp": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Email verified successfully. You can now log in."
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/resend-otp": {
      "post": {
        "summary": "Resend OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" }
                }
              },
              "example": {
                "email": "jane@example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "OTP resent to jane@example.com"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "summary": "Forgot password (send OTP)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" }
                }
              },
              "example": {
                "email": "jane@example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "summary": "Reset password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "otp": { "type": "string" },
                  "newPassword": { "type": "string" },
                  "required": ["email", "otp", "newPassword"]
                }
              },
              "example": {
                "email": "jane@example.com",
                "otp": "123456",
                "newPassword": "NewP@ssw0rd"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "summary": "Sign in with Google (provide id_token from client)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": { "type": "string" }
                }
              },
              "example": {
                "idToken": "<google-id-token>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Login successful.",
                  "data": {
                    "user": {
                      "id": "user_1",
                      "fullName": "Google User",
                      "email": "google@example.com",
                      "role": "USER"
                    },
                    "accessToken": "<jwt>",
                    "refreshToken": "<refresh>"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mono/link-session": {
      "post": {
        "summary": "Create a Mono link session (returns Mono Connect URL for frontend/mobile)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Create a pending hosted-link session. Customer and meta.ref come from the server. Redirect aliases must agree and match the configured allowlist. Hosted completion uses webhooks, not a guaranteed redirect code. Mobile clients must explicitly send trackiq://mono/callback configured as MONO_MOBILE_REDIRECT_URL. MONO_WEB_REDIRECT_URL separately configures a served HTTPS frontend callback. Redirects must exactly match configuration and are never rewritten. The old TrackFund mobile scheme is rejected.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "redirect_url": {
                    "type": "string",
                    "description": "Frontend callback URL passed to Mono."
                  },
                  "redirectUrl": {
                    "type": "string",
                    "description": "Compatibility alias; backend normalizes this to `redirect_url`."
                  },
                  "callback_url": {
                    "type": "string",
                    "description": "Compatibility alias; backend normalizes this to `redirect_url`."
                  },
                  "callbackUrl": {
                    "type": "string",
                    "description": "Compatibility alias; backend normalizes this to `redirect_url`."
                  },
                  "scope": {
                    "type": "string",
                    "default": "auth",
                    "example": "auth",
                    "description": "Compatibility field; server always uses auth."
                  }
                }
              },
              "example": {
                "redirect_url": "trackiq://mono/callback"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pending link: data contains mono_url, compatibility client_token, reference, status, scope, redirect_url",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "client_token": {
                          "type": "string",
                          "description": "Non-empty link credential. Uses Mono client_token when present, otherwise mono_url for current Mono v2 responses."
                        },
                        "mono_url": {
                          "type": "string"
                        },
                        "scope": {
                          "type": "string"
                        },
                        "redirect_url": {
                          "type": "string"
                        },
                        "reference": {
                          "type": "string",
                          "description": "Server-generated reference persisted against the authenticated user."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "pending"
                          ]
                        }
                      },
                      "required": [
                        "mono_url",
                        "reference",
                        "status"
                      ]
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "client_token": "https://link.mono.co/ALB65XCPXCOU",
                    "mono_url": "https://link.mono.co/ALB65XCPXCOU",
                    "scope": "auth",
                    "redirect_url": "trackiq://mono/callback",
                    "reference": "server-generated-reference",
                    "status": "pending"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Missing, conflicting or non-allowed callback, or incomplete user profile"
          },
          "502": {
            "description": "Provider failure or unusable link response"
          },
          "503": {
            "description": "Session storage unavailable"
          },
          "504": {
            "description": "Provider timeout"
          }
        }
      }
    },
    "/api/mono/complete-link": {
      "post": {
        "summary": "Exchange Mono short-lived code on server and persist accounts",
        "security": [{ "bearerAuth": [] }],
        "description": "Frontend posts the `code` received from Mono Connect to this endpoint. Server exchanges it with Mono using the secret key and upserts returned accounts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "code": { "type": "string" } }, "required": ["code"] },
              "example": { "code": "mono_code_abc123" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "accounts upserted",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object" } } },
                "example": { "success": true, "data": { "accounts": [ { "id": "internal_id_1", "monoAccountId": "mono_acc_1", "accountName": "Primary" } ] } }
              }
            }
          },
          "400": { "description": "Bad request / invalid code" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/mono/accounts": {
      "post": {
        "summary": "Exchange Mono short-lived code on server and persist account",
        "security": [{ "bearerAuth": [] }],
        "description": "Flutter may call this after Mono redirects back with a code. Server exchanges it with Mono and stores the linked account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "code": { "type": "string" } }, "required": ["code"] },
              "example": { "code": "mono_code_abc123" }
            }
          }
        },
        "responses": {
          "200": { "description": "account upserted" },
          "400": { "description": "Bad request / missing code" },
          "401": { "description": "Unauthorized" }
        }
      },
      "get": {
        "summary": "List Mono accounts for the authenticated user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/MonoAccount" } } } },
                "example": { "success": true, "data": [ { "id": "internal_id_1", "monoAccountId": "mono_acc_1", "accountName": "Primary", "accountNumber": "0123456789", "bankCode": "001", "currency": "NGN" } ] }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/mono/accounts/{id}/transactions": {
      "get": {
        "summary": "Get transactions for an internal mono account id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MonoTransaction"
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "transactionId": "tx_1",
                      "amount": 5000,
                      "currency": "NGN",
                      "paidAt": "2026-06-20T00:00:00Z",
                      "description": "Test payment"
                    }
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Account data still syncing or unavailable",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "status": "syncing",
                    "transactions": []
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Account owned by another user"
          },
          "404": {
            "description": "Account not found"
          },
          "409": {
            "description": "Bank account disconnected"
          },
          "502": {
            "description": "Provider data retrieval failed"
          },
          "503": {
            "description": "Account storage unavailable"
          }
        },
        "description": "Verify account ownership and readiness before returning cached transactions. 202 means syncing/unavailable; 200 with data: [] means a successful sync returned no transactions."
      }
    },
    "/api/mono/webhook": {
      "post": {
        "summary": "Mono webhook endpoint (public)",
        "description": "Public endpoint authenticated only by mono-webhook-secret. Persist events before 200; duplicate event IDs with identical canonical payloads return 200. PostgreSQL worker processes events transactionally with retries. Do not send a Bearer token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MonoWebhook"
              },
              "example": {
                "event": "mono.events.account_connected",
                "event_id": "unique-event-id",
                "timestamp": "2026-10-26T09:00:00Z",
                "data": {
                  "id": "provider-account-id",
                  "meta": {
                    "ref": "saved-reference",
                    "data_status": "PROCESSING"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durably received; business processing continues asynchronously"
          },
          "400": {
            "description": "Invalid event envelope"
          },
          "401": {
            "description": "Missing or incorrect webhook secret"
          },
          "409": {
            "description": "Same event ID used for a different payload"
          },
          "413": {
            "description": "Payload exceeds 1 MiB"
          },
          "503": {
            "description": "Storage or secret configuration unavailable; retry"
          }
        },
        "parameters": [
          {
            "name": "mono-webhook-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/funds": {
