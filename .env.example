# Copy to .env for Docker Compose. Go and run.ps1 do not load .env.
# For those entrypoints set process environment variables instead.
ENV=development
# Required: generate a random secret of at least 32 bytes. Never commit it.
JWT_SECRET=
# Leave all SMTP fields below blank for development-only OTP logging.
# Production requires all four fields. Use a newly rotated SMTP password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Mono remains unavailable until its credentials and URLs are configured.
MONO_PUBLIC_KEY=test_pk_efzgx4qrswlhyon9m2d8
MONO_SECRET_KEY=test_sk_prizrzo14ykt0rmn3g1q
MONO_BASE_URL=https://api.withmono.com/v2
MONO_CALLBACK_URL=https://thetrackiq.co/mono/callback
# Add exact HTTPS callbacks here for web (comma-separated). No wildcards.
MONO_ALLOWED_REDIRECT_URLS=https://thetrackiq.co/mono/callback,trackfund://mono/callback
MONO_WEBHOOK_SECRET=
MONO_TIMEOUT_SECONDS=30
MONO_DEBUG_LOGGING=false
